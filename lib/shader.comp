#version 430 core

layout (local_size_x=1,local_size_y=1) in;

struct Entity{
	vec2 position;
	vec2 dimension;
};

layout (std430,binding=0) buffer EntityBuffer{
	Entity entities[];
};


void main()
{
	uint idx = gl_GlobalInvocationID.x;
	if(idx < 20000) return;
	entities[idx].position.x += 0.01;
	entities[idx].position.y += 0.01;
}

